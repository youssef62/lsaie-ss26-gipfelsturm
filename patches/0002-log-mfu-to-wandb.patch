# Patch: Log Model FLOP Utilization (MFU) to stdout, TensorBoard, and W&B
#
# Problem:
#   Megatron-LM logs TFLOP/s/GPU but not MFU.
#   MFU = TFLOP/s/GPU / peak_GPU_TFLOP/s * 100 is the standard efficiency
#   metric for comparing runs across hardware and is useful for challenge
#   leaderboards and efficiency analysis.
#
# What this patch does:
#   1. Adds a `peak_gpu_tflops` field to LoggerConfig in training_config.py.
#      Pass `--peak-gpu-tflops <value>` to enable MFU logging.
#   2. In training_log() in training.py, computes MFU whenever
#      `args.peak_gpu_tflops` is set and `args.log_throughput` is True.
#   3. Appends MFU to the stdout log string.
#   4. Logs MFU to TensorBoard as 'mfu' and to W&B as 'mfu'.
#
# Where in the code:
#   File: megatron/training/training_config.py — LoggerConfig dataclass
#   File: megatron/training/training.py — training_log(), inside
#   the `if args.log_throughput:` block, after tokens/sec/GPU logging.
#
# How to enable:
#   Add `--peak-gpu-tflops <value>` to your launch script.
#   Common values (BF16 peak, per GPU):
#     GH200 / H100 SXM:  989 TFLOP/s
#     H100 PCIe:         756 TFLOP/s
#     A100 SXM:          312 TFLOP/s
#
# How to fix if this patch breaks on a future Megatron version:
#   Search for `log_throughput` in training.py. Find the block that logs
#   throughput and tokens-per-sec-per-gpu. Add the mfu computation and
#   logging calls immediately after. In training_config.py, add the
#   `peak_gpu_tflops` field to LoggerConfig.
#
# Depends on: 0001-log-tokens-per-sec-to-wandb.patch (must be applied first)
# Applied to: Megatron-LM core_v0.16.1
#
diff --git a/megatron/training/training_config.py b/megatron/training/training_config.py
index xxxxxxxxx..xxxxxxxxx 100644
--- a/megatron/training/training_config.py
+++ b/megatron/training/training_config.py
@@ -206,6 +206,10 @@ class LoggerConfig:
     log_throughput: bool = False
     """If set, calculate and log throughput per GPU."""

+    peak_gpu_tflops: float | None = None
+    """Peak GPU throughput in TFLOP/s used to compute Model FLOP Utilization (MFU).
+    If set, MFU (%) is logged alongside TFLOP/s/GPU whenever --log-throughput is active."""
+
     log_throughput_to_tensorboard: bool = False
     """Enable throughput logging to tensorboard."""

diff --git a/megatron/training/training.py b/megatron/training/training.py
index a51a9846a..xxxxxxxxx 100644
--- a/megatron/training/training.py
+++ b/megatron/training/training.py
@@ -2043,14 +2043,21 @@ def training_log(
         if args.log_throughput:
             tokens_per_sec_per_gpu = batch_size * args.seq_length / (
                 elapsed_time_per_iteration * args.world_size
             )
             log_string += f' throughput per GPU (TFLOP/s/GPU): {throughput:.1f} |'
             log_string += f' tokens/sec/GPU: {tokens_per_sec_per_gpu:.0f} |'
+            mfu = throughput / args.peak_gpu_tflops * 100.0 if args.peak_gpu_tflops else None
+            if mfu is not None:
+                log_string += f' MFU: {mfu:.2f}% |'
             if args.log_timers_to_tensorboard:
                 if writer:
                     writer.add_scalar('throughput', throughput, iteration)
                     writer.add_scalar('tokens-per-sec-per-gpu', tokens_per_sec_per_gpu, iteration)
+                    if mfu is not None:
+                        writer.add_scalar('mfu', mfu, iteration)
                 if wandb_writer:
                     wandb_writer.log({'throughput': throughput}, iteration)
                     wandb_writer.log({'tokens-per-sec-per-gpu': tokens_per_sec_per_gpu}, iteration)
+                    if mfu is not None:
+                        wandb_writer.log({'mfu': mfu}, iteration)
         if args.log_energy:
